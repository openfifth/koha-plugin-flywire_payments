[% USE raw %]
[% PROCESS 'i18n.inc' %]
[% SET method = 'configure' %]
[% SET plugin_title = t("Flywire Payments") %]
[% WRAPPER 'wrapper-staff-tool-plugin.inc' %]
<h1>Flywire Payments: Configuration</h1>

<div class="alert alert-info">
    <p>
        <img src="data:image/png;base64," alt="Open Fifth" height="26" />
        &nbsp;
        <img src="data:image/svg+xml;base64," alt="Flywire" height="26" />
    </p>
    <p>This plugin is developed by <a href="https://openfifth.co.uk" target="_blank" rel="noopener">Open Fifth</a> and integrates with the Flywire payment portal.
    See the <a href="https://developers.flywire.com/education/Content/pay-by-link-json-links.htm" target="_blank" rel="noopener">Flywire API documentation</a>.</p>
</div>

<form method="post" autocomplete="off">
    [% INCLUDE 'csrf-token.inc' %]
    <!-- Always pass class and method so the plugin system knows what to execute -->
    <input type="hidden" name="class" value="[% CLASS | html %]"/>
    <input type="hidden" name="method" value="[% METHOD | html %]"/>

    <fieldset class="rows">
        <legend>General Settings</legend>

        <ol>
            <li>
                <label for="enable_opac_payments">Accept payments in the OPAC: </label>
                <select name="enable_opac_payments" id="enable_opac_payments">
                    [% IF enable_opac_payments == 'No' %]
                    <option value="No" selected="selected">No</option>
                    [% ELSE %]
                    <option value="No">No</option>
                    [% END %]

                    [% IF enable_opac_payments == 'Yes' %]
                    <option value="Yes" selected="selected">Yes</option>
                    [% ELSE %]
                    <option value="Yes">Yes</option>
                    [% END %]
                </select>
                <span class="hint">When set to Yes, patrons can pay their charges through Flywire from their OPAC account page.</span>
            </li>

            <li>
                <label for="FlywireDebugMode">Debug mode: </label>
                <select name="FlywireDebugMode" id="FlywireDebugMode">
                    [% IF FlywireDebugMode == 'Yes' %]
                    <option value="Yes" selected="selected">Yes</option>
                    [% ELSE %]
                    <option value="Yes">Yes</option>
                    [% END %]

                    [% IF FlywireDebugMode == 'No' || !FlywireDebugMode %]
                    <option value="No" selected="selected">No</option>
                    [% ELSE %]
                    <option value="No">No</option>
                    [% END %]
                </select>
                <span class="hint">Writes extra detail to the logs and allows the Demo environment to be selected. Turn off for live use.</span>
            </li>
        </ol>
    </fieldset>

    <fieldset class="rows">
        <legend>Flywire API Settings</legend>
        <p>These settings are provided by Flywire when your portal is set up.</p>
        <ol>
            <li>
                <label for="FlywireProvider">Portal code: </label>
                <input type="text" name="FlywireProvider" id="FlywireProvider" value="[% FlywireProvider | html %]" autocomplete="off" data-lpignore="true" data-1p-ignore data-bwignore data-form-type="other" />
                <span class="hint">The portal code Flywire gave you when your portal was set up (sent to Flywire as the "provider").</span>
            </li>

            <li>
                <label for="FlywirePaymentDestination">Payment destination: </label>
                <input type="text" name="FlywirePaymentDestination" id="FlywirePaymentDestination" value="[% FlywirePaymentDestination | html %]" autocomplete="off" data-lpignore="true" data-1p-ignore data-bwignore data-form-type="other" />
                <span class="hint">The subdomain of your Flywire payment site, without ".flywire.com" (e.g. "kohademo").</span>
            </li>

            <li>
                <label for="FlywireSharedSecret">Shared secret: </label>
                <input type="password" name="FlywireSharedSecret" id="FlywireSharedSecret" value="[% FlywireSharedSecret | html %]" autocomplete="new-password" data-lpignore="true" data-1p-ignore data-bwignore data-form-type="other" />
                <span class="hint">The secret key from Flywire. It signs payment requests and verifies the payment notifications Flywire sends back to Koha.</span>
            </li>
        </ol>
    </fieldset>

    <fieldset class="rows" id="debug-settings">
        <legend>Environment (debug mode only)</legend>
        <ol>
            <li>
                <label for="FlywireEnvironment">Environment: </label>
                <select name="FlywireEnvironment" id="FlywireEnvironment">
                    [% IF FlywireEnvironment == 'demo' %]
                    <option value="demo" selected="selected">Demo (Testing)</option>
                    [% ELSE %]
                    <option value="demo">Demo (Testing)</option>
                    [% END %]

                    [% IF FlywireEnvironment == 'production' || !FlywireEnvironment %]
                    <option value="production" selected="selected">Production (Live)</option>
                    [% ELSE %]
                    <option value="production">Production (Live)</option>
                    [% END %]
                </select>
                <span class="hint">Demo is for testing with Flywire's test portal; Production takes real payments.</span>
            </li>
        </ol>
    </fieldset>

    <fieldset class="rows">
        <legend>Active Endpoint</legend>
        <p id="active-endpoint"></p>
        <p><strong>Callback URL:</strong> [% OPACBaseURL %]/api/v1/contrib/flywirepayments/callback</p>
    </fieldset>

    <fieldset class="action">
        <input type="hidden" name="op" value="cud-save" />
        <input type="submit" class="btn btn-primary" value="Save configuration" />
        <a class="cancel" href="/cgi-bin/koha/plugins/plugins-home.pl">Cancel</a>
    </fieldset>
</form>

<script>
    (function () {
        var endpoints = {
            demo: 'https://gateway.demo.flywire.com/v1/transfers.json',
            production: 'https://gateway.flywire.com/v1/transfers.json'
        };
        var debugMode = document.getElementById('FlywireDebugMode');
        var environment = document.getElementById('FlywireEnvironment');
        var debugSettings = document.getElementById('debug-settings');
        var endpointDisplay = document.getElementById('active-endpoint');

        function updateEndpointDisplay() {
            var env = environment.value || 'production';
            var label = env === 'demo' ? 'Demo' : 'Production';
            endpointDisplay.textContent = '';
            var strong = document.createElement('strong');
            strong.textContent = label + ':';
            endpointDisplay.appendChild(strong);
            endpointDisplay.appendChild(document.createTextNode(' ' + endpoints[env]));
        }

        function updateDebugVisibility() {
            if (debugMode.value === 'Yes') {
                debugSettings.style.display = '';
            } else {
                debugSettings.style.display = 'none';
                // Reset to production when debug is disabled
                environment.value = 'production';
            }
            updateEndpointDisplay();
        }

        updateDebugVisibility();
        debugMode.addEventListener('change', updateDebugVisibility);
        environment.addEventListener('change', updateEndpointDisplay);
    })();
</script>
[% END %]
